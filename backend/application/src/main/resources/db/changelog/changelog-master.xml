<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0" author="jobsearcher">
        <createTable tableName="resume">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_resume"/>
            </column>
            <column name="name" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="varchar(58)"/>
            <column name="desired_position" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="employer_level" type="smallint">
                <constraints nullable="false"/>
            </column>
            <column name="working_format" type="smallint"/>
            <column name="about" type="text"/>
        </createTable>

        <createTable tableName="experience">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_experience"/>
            </column>
            <column name="company" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="from" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="to" type="date"/>
            <column name="description" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="resume_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="experience"
                baseColumnNames="resume_id"
                referencedTableName="resume"
                referencedColumnNames="id"
                constraintName="fk_experience_resume"
                onDelete="CASCADE"/>

    </changeSet>

</databaseChangeLog>