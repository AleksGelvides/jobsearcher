              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Application"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Доступ запрещён или не прошла проверка CSRF"
          },
          "default": {
            "description": "Ошибка API"
          }
        }
      }
    },
    "/api/v1/automation": {
      "get": {
        "operationId": "getAutomation",
