        "properties": {
          "role": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "arrangement": {
            "type": "string"
          },
          "salary": {
            "type": "integer",
            "minimum": 0
          },
          "level": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "experience": {
            "type": "string"
          },
          "workExperience": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Experience"
            }
          }
        }
      }
    }
  }
