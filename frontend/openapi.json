{
  "openapi": "3.1.0",
  "info": {
    "title": "JobPilot REST API",
    "version": "0.1.0",
    "description": "Проект контракта по макетам JobPilot. Операции /api/v1 требуют реализации Spring Boot. Регистрация, вход, подтверждение почты и восстановление пароля выполняются в Keycloak. Маршруты браузерной сессии описаны по существующему клиенту launcher."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "jobPilotSession": []
    }
  ],
  "paths": {
    "/login": {
      "get": {
        "operationId": "login",
        "tags": ["Keycloak"],
        "summary": "Начать вход через Keycloak",
        "x-implementation": "existing",
        "responses": {
          "302": {
            "description": "Перенаправление",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": []
      }
    },
    "/__jobpilot/session": {
      "get": {
        "operationId": "session",
        "tags": ["Keycloak"],
        "summary": "Проверить сессию JobPilot",
        "x-implementation": "existing",
        "responses": {
          "204": {
            "description": "Сессия активна"
          },
          "401": {
            "description": "Требуется вход"
          }
        },
        "security": []
      }
    },
    "/api/v1/workspace": {
      "get": {
        "operationId": "getWorkspace",
        "tags": ["Workspace"],
        "summary": "Загрузить данные обзора и рабочего пространства",
        "x-implementation": "proposed",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Доступ запрещён или не прошла проверка CSRF"
          },
          "default": {
            "description": "Ошибка API"
          }
        }
      }
    },
    "/api/v1/profile": {
      "put": {
        "operationId": "saveProfile",
        "tags": ["Profile"],
        "summary": "Сохранить профиль, навыки и опыт кандидата",
        "x-implementation": "proposed",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Candidate"
                }
              }
            }
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Доступ запрещён или не прошла проверка CSRF"
          },
          "default": {
            "description": "Ошибка API"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Candidate"
              }
            }
          }
        }
      }
    },
    "/api/v1/resumes": {
      "post": {
        "operationId": "uploadResume",
        "tags": ["Resumes"],
        "summary": "Загрузить основное резюме",
        "x-implementation": "proposed",
        "responses": {
          "201": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resume"
                }
              }
            }
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Доступ запрещён или не прошла проверка CSRF"
          },
          "default": {
            "description": "Ошибка API"
          },
          "413": {
            "description": "Слишком большой файл"
          },
          "415": {
            "description": "Тип файла не поддерживается"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/vacancies": {
      "get": {
        "operationId": "listVacancies",
        "tags": ["Vacancies"],
        "summary": "Поиск, фильтрация и пагинация вакансий",
        "x-implementation": "proposed",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VacancyPage"
                }
              }
            }
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Доступ запрещён или не прошла проверка CSRF"
          },
          "default": {
            "description": "Ошибка API"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["match", "salary"]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["remote", "salary", "java", "source"]
              }
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/vacancies/{vacancyId}": {
      "get": {
        "operationId": "getVacancy",
        "tags": ["Vacancies"],
        "summary": "Карточка вакансии и результаты анализа",
        "x-implementation": "proposed",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VacancyDetails"
                }
              }
            }
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Доступ запрещён или не прошла проверка CSRF"
          },
          "default": {
            "description": "Ошибка API"
          },
          "404": {
            "description": "Вакансия недоступна"
          }
        },
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/vacancies/{vacancyId}/application-draft": {
      "post": {
        "operationId": "prepareApplication",
        "tags": ["Applications"],
        "summary": "Подготовить резюме и сопроводительное письмо",
        "x-implementation": "proposed",
        "responses": {
          "201": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
