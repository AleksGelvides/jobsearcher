          "429": {
            "description": "Слишком частые запросы"
          },
          "default": {
            "description": "Ошибка браузерной сессии"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
