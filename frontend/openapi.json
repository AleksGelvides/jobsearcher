    },
    "/__jobpilot/aggregator-login/hh": {
      "post": {
        "operationId": "openHhLogin",
        "tags": ["Aggregators"],
        "summary": "Открыть окно входа HH.ru",
        "x-implementation": "existing",
        "responses": {
          "201": {
            "description": "Сессия браузера создана",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Сессия недоступна"
          }
        },
        "parameters": [
          {
            "name": "X-JobPilot-Launcher",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["1"]
            }
          }
        ],
        "security": []
      }
    },
    "/__jobpilot/aggregator-login/{id}": {
      "get": {
        "operationId": "getAggregatorLoginStatus",
        "tags": ["Aggregators"],
        "summary": "Результат проверки входа на площадку",
        "x-implementation": "existing",
        "responses": {
          "200": {
            "description": "Вход подтверждён по сессии браузера",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["state"],
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": ["confirmed"]
                    }
                  }
                }
              }
            }
          },
          "204": {
            "description": "Ожидается подтверждение"
          },
          "404": {
            "description": "Сессия браузера завершилась"
          },
          "429": {
            "description": "Слишком частые запросы"
          },
          "default": {
            "description": "Ошибка браузерной сессии"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-JobPilot-Launcher",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["1"]
            }
          }
        ],
        "security": []
      },
      "delete": {
        "operationId": "closeAggregatorLogin",
        "tags": ["Aggregators"],
        "summary": "Закрыть окно браузера",
        "x-implementation": "existing",
        "responses": {
          "204": {
            "description": "Сессия закрыта"
          },
          "404": {
            "description": "Сессия браузера завершилась"
          },
          "429": {
            "description": "Слишком частые запросы"
          },
          "default": {
            "description": "Ошибка браузерной сессии"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-JobPilot-Launcher",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["1"]
            }
          }
        ],
        "security": []
      }
    },
