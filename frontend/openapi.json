  "components": {
    "securitySchemes": {
      "jobPilotSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "Experience": {
        "type": "object",
        "required": ["company", "role", "from", "to", "description"],
        "properties": {
          "company": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Candidate": {
        "type": "object",
        "required": [
          "name",
          "role",
          "city",
          "arrangement",
          "salary",
          "level",
          "skills",
          "experience"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "arrangement": {
            "type": "string"
          },
          "salary": {
            "type": "integer",
            "minimum": 0
          },
          "level": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "experience": {
            "type": "string"
          },
          "workExperience": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Experience"
            }
          }
        }
      },
      "Vacancy": {
        "type": "object",
        "required": [
          "id",
          "title",
          "company",
          "salary",
          "skills",
          "source",
          "remote"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "salary": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "remote": {
            "type": "boolean"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "VacancyDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Vacancy"
          },
          {
            "type": "object",
            "required": [],
            "properties": {
              "analysis": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["title", "description"],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
