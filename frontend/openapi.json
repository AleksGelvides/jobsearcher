            "type": "string"
          }
        }
      },
      "Application": {
        "type": "object",
        "required": ["title", "company", "status", "date", "source", "resume"],
        "properties": {
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["Приглашение", "На рассмотрении", "Отказ", "Отправлено"]
          },
          "date": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "resume": {
            "type": "string"
          }
        }
      },
      "ApplicationDraft": {
        "type": "object",
        "required": ["id", "resumeName", "coverLetter"],
        "properties": {
          "id": {
            "type": "string"
          },
          "resumeName": {
            "type": "string"
          },
          "coverLetter": {
            "type": "string"
          }
        }
      },
      "Automation": {
        "type": "object",
        "required": ["active", "salary", "schedule", "mode"],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "salary": {
            "type": "integer",
            "minimum": 0
          },
          "schedule": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        }
      },
      "Run": {
        "type": "object",
        "required": ["time", "found", "sent", "result"],
        "properties": {
          "time": {
            "type": "string"
          },
          "found": {
            "type": "string"
          },
          "sent": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": ["Успешно", "Без новых", "Нужен вход"]
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": [
          "candidate",
          "vacancies",
          "applications",
          "runs",
          "resume",
          "automation"
        ],
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/Candidate"
          },
          "vacancies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vacancy"
            }
          },
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          },
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Run"
            }
          },
          "resume": {
            "type": "string"
          },
          "automation": {
            "$ref": "#/components/schemas/Automation"
          }
        }
      },
      "Resume": {
        "type": "object",
        "required": ["fileName"],
        "properties": {
          "fileName": {
            "type": "string"
          }
        }
