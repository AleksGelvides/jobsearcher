      "BrowserInput": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["text", "key", "paste"]
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": ["type", "x", "y"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["click", "down", "up", "move"]
              },
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": ["type", "x", "y", "deltaX", "deltaY"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["wheel"]
              },
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "deltaX": {
                "type": "number"
              },
              "deltaY": {
                "type": "number"
              }
            }
          }
        ]
      },
      "OnboardingAnswers": {
        "type": "object",
        "required": [
          "role",
          "city",
          "arrangement",
          "salary",
          "level",
          "skills",
          "experience"
