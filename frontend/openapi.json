                }
              }
            }
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Доступ запрещён или не прошла проверка CSRF"
          },
          "default": {
            "description": "Ошибка API"
          }
        },
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/application-drafts/{draftId}/submit": {
      "post": {
        "operationId": "submitApplication",
        "tags": ["Applications"],
        "summary": "Подтвердить отправку отклика. Повтор по тому же draftId должен вернуть сохранённый результат без повторной отправки",
        "x-implementation": "proposed",
        "responses": {
          "200": {
            "description": "Успешный результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Доступ запрещён или не прошла проверка CSRF"
          },
          "default": {
            "description": "Ошибка API"
          },
          "409": {
            "description": "Отправка уже выполняется"
          }
        },
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["coverLetter"],
                "properties": {
                  "coverLetter": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/applications": {
      "get": {
        "operationId": "listApplications",
        "tags": ["Applications"],
        "summary": "История откликов",
        "x-implementation": "proposed",
        "responses": {
          "200": {
            "description": "Успешный результат",
